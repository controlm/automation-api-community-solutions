# Copy this file to .env and fill in real values.
# .env itself should be gitignored - never commit real credentials or sys_ids
# from a production instance to a public repository.

# ServiceNow instance and OAuth Client Credentials grant
SERVICENOW_INSTANCE=your-instance-name
SERVICENOW_CLIENT_ID=your-client-id
SERVICENOW_CLIENT_SECRET=your-client-secret

# sys_id of the ServiceNow user to attribute incidents to as caller
SERVICENOW_CALLER_ID=your-caller-sys-id

# Path to the generated routing rules file. You do not create this file by
# hand - edit config/mapping_source.json (plain ServiceNow names) and run
# setup_resolve_mapping.py, which writes config/mapping.json with the
# resolved sys_ids. Rules are evaluated in order, first match wins, and the
# list must end with a catch-all rule (pattern: "*").
MAPPING_FILE=config/mapping.json

# Set to 'true' to let the script run against a built-in sample alert
# when no CLI arguments are supplied (useful for local testing/demos)
SNOW_CTM_DEMO_MODE=false

# Default console verbosity when no -v/-q flag is passed on the command
# line. One of: quiet | normal | verbose
#   quiet   - only warnings, errors, and the final incident summary line
#   normal  - step-by-step progress (default)
#   verbose - normal + full raw ServiceNow response bodies for troubleshooting
LOG_LEVEL=normal

# Control-M Automation API (AAPI) base URL and API token, used by
# ctm_client.py for job status/log/output lookups. Base URL includes the
# /automation-api path, e.g. https://ctm-em.example.com:8443/automation-api
CONTROLM_URL=https://your-ctm-em-host:8443/automation-api
CONTROLM_API_KEY=your-controlm-aapi-token

# Set to 'true' to have ctm_client.py print every AAPI request (method,
# URL, params/body) and the raw response (status + body) it gets back.
# Independent of LOG_LEVEL/-v - useful when the AAPI's response doesn't
# match what actually happened (e.g. a 200 "ok" that didn't apply).
CONTROLM_DEBUG=false
