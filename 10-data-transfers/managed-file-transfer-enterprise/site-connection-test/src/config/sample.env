# .env for ldap_smtp_test.py — used when testing from a machine that does
# NOT have hub_config.properties available (i.e. not the MFTE hub itself).
#
# Uses the SAME key names as hub_config.properties, so you can copy lines
# straight from the hub with no renaming. Only one line at the bottom
# (SMTP_TEST_RECIPIENT) is specific to this script.
#
# DO NOT put passwords in here. The script drops any key ENDING in
# "password", "passwd", "secret", or "pwd" (e.g. hub.ldap.search-password,
# spring.mail.password) and always prompts for the real password
# interactively instead. This is a suffix match, not substring — a field
# like hub.ldap.password-attribute-name is NOT treated as a secret, since
# that's a schema field name, not an actual credential.

# --- LDAP connection ---
hub.ldap.search-user=CN=ldap_mfte,CN=Managed Service Accounts,DC=shytwr,DC=net
hub.ldap.ldap-url=ldaps://ldap.shytwr.net:636
hub.ldap.base-dn=OU=MFTE,OU=Control-M,DC=shytwr,DC=net
hub.ldap.group-search-base-dn=OU=MFTE,OU=Control-M,DC=shytwr,DC=net
hub.ldap.timeout=10
hub.ldap.username-attribute-name=sAMAccountName
hub.ldap.dn-attribute-name=distinguishedName

# --- LDAP attribute schema (used by the schema validation check) ---
hub.ldap.password-attribute-name=userPassword
hub.ldap.first-name-attribute-name=givenName
hub.ldap.last-name-attribute-name=sn
hub.ldap.company-name-attribute-name=company
hub.ldap.email-attribute-name=userPrincipalName
hub.ldap.phone-attribute-name=telephoneNumber
hub.ldap.group-name-attribute-name=sAMAccountName
hub.ldap.member-attribute-name=member
hub.ldap.member-of-attribute-name=memberof
hub.ldap.description-attribute-name=description
hub.ldap.ssh-public-key-attribute-name=ipPhone

# --- SMTP connection ---
spring.mail.host=smtp.shytwr.net
spring.mail.port=587
spring.mail.username=oversight
spring.mail.properties.mail.smtp.starttls.enable=true
spring.mail.properties.mail.smtp.starttls.required=true
spring.mail.properties.mail.smtp.connectiontimeout=30000

# --- Company / template info ---
b2b.company.mail.address=support@shytwr.net
b2b.company.name=Werkstatt 72
b2b.hub.proxy.domain.name=werkstatt.shytwr.net

# --- Script-only setting (not a hub_config.properties field) ---
# Pre-fills the recipient prompt — press Enter to accept, or type a
# different address to override for a one-off test.
SMTP_TEST_RECIPIENT=orchestrator@bmc.com