# sample.env for ldap_smtp_test.py / werkstatt.ldap.smtp.test.py,
# werkstatt.ldaps.cert.import.sh, and werkstatt.smtp.cert.import.sh —
# used when testing from a machine that does NOT have
# hub_config.properties available (i.e. not the MFTE hub itself).
#
# Bash-safe key names (LDAP_*, SMTP_*) so this block can be pasted
# directly into the shared, bash-sourced config/.env that mfte.sh reads
# on the hub (see privacy-guard/src/config/sample.env) without breaking
# `source`. The dotted hub_config.properties-style key names
# (hub.ldap.ldap-url, spring.mail.host, etc.) are still recognized as a
# fallback if you'd rather paste a block straight from the hub with no
# renaming — see LDAP_PREFIX_MAP / SMTP_PREFIX_MAP / LDAP_ATTR_MAP in
# werkstatt.ldap.smtp.test.py.
#
# DO NOT put passwords in here. The script drops any key ENDING in
# "password", "passwd", "secret", or "pwd" and always prompts for the
# real password interactively instead. This is a suffix match, not
# substring — a field like LDAP_ATTR_PASSWORD (an attribute NAME, e.g.
# "userPassword") is NOT treated as a secret.

# --- LDAP connection ---
LDAP_SEARCH_USER="CN=ldap_svc,CN=Managed Service Accounts,DC=werkstatt,DC=local"
LDAP_URL="ldaps://ldap.werkstatt.local:636"
LDAP_BASE_DN="OU=Example,DC=werkstatt,DC=local"
LDAP_GROUP_SEARCH_BASE_DN="OU=Example,DC=werkstatt,DC=local"
LDAP_TIMEOUT="10"
LDAP_USERNAME_ATTR="sAMAccountName"
LDAP_DN_ATTR="distinguishedName"

# --- LDAP attribute schema (used by the schema validation check) ---
LDAP_ATTR_PASSWORD="userPassword"
LDAP_ATTR_FIRST_NAME="givenName"
LDAP_ATTR_LAST_NAME="sn"
LDAP_ATTR_COMPANY_NAME="company"
LDAP_ATTR_EMAIL="userPrincipalName"
LDAP_ATTR_PHONE="telephoneNumber"
LDAP_ATTR_GROUP_NAME="sAMAccountName"
LDAP_ATTR_MEMBER="member"
LDAP_ATTR_MEMBER_OF="memberof"
LDAP_ATTR_DESCRIPTION="description"
LDAP_ATTR_SSH_PUBLIC_KEY="ipPhone"

# --- SMTP connection ---
SMTP_HOST="smtp.werkstatt.local"
SMTP_PORT="587"
SMTP_USERNAME="svc-account"
SMTP_STARTTLS_ENABLE="true"
SMTP_STARTTLS_REQUIRED="true"
SMTP_CONNECTION_TIMEOUT="30000"

# --- Company / template info ---
SMTP_SENDER="support@werkstatt.local"
SMTP_COMPANY_NAME="Werkstatt 72"
SMTP_PROXY_DOMAIN="werkstatt.local"

# --- Script-only setting (not a hub_config.properties field) ---
# Pre-fills the recipient prompt — press Enter to accept, or type a
# different address to override for a one-off test.
SMTP_TEST_RECIPIENT="test-recipient@werkstatt.local"
