###############################################################################
# Graylog forwarding (optional)
###############################################################################

# Consumed by mfte.rule.vars.all.jsonl.sh's write_graylog_report(). When
# enabled, posts a GELF-formatted copy of every report to Graylog in
# addition to whichever local sink MFTE_LOG_FORMAT already writes -- this
# is an independent toggle, not a new MFTE_LOG_FORMAT value. None of these
# variables are used by anything else in privacy-guard, so they're not
# duplicated into sample.env -- if you want Graylog forwarding on a given
# host, copy this block into the deployed MFTE_OPS_HOME/config/.env
# alongside the variables from sample.env.

MFTE_GRAYLOG_ENABLED=false
MFTE_GRAYLOG_URL=http://graylog.werkstatt.local:12201/gelf
MFTE_GRAYLOG_TIMEOUT=5
# soft = log the failure and continue (default); hard = treat a failed
# Graylog post the same as a failed local write (job reports failure).
MFTE_GRAYLOG_FAIL_MODE=soft
